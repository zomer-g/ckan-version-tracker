.env
__pycache__/
*.pyc
*.pyo
.pytest_cache/
node_modules/
frontend/dist/
.vscode/
.idea/
*.egg-info/
dist/
build/
# Local agent state — settings, worktrees, session scratch. One exception: a
# SKILL that documents how to work on THIS repo is part of the repo, not a
# machine-local preference, so it is versioned like any other doc. Git cannot
# re-include a path under an excluded directory, hence the step-by-step form.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/over-sql/

# Dev-server logs and the Vite/TS incremental build cache — local artifacts,
# regenerated on every run, never meaningful in history.
*.log
frontend/tsconfig.tsbuildinfo

# One-off analysis scripts and their data dumps under scripts/ — local scratch,
# not part of the tracked tooling (e.g. scripts/create_append_readonly_role.sql).
scripts/empty_ds_ids.json
scripts/find_empty.py
scripts/k24_committees.json
scripts/k25_committees.json
scripts/protocol_counts.json
scripts/r2_coverage.py
scripts/scan_giants.py
scripts/status_map.py
scripts/verify_r2_batch.py

# Local dev-only API proxy target for the vite dev server (see vite.config.ts).
.env.local
frontend/.env.local

# Database dumps. The OCOI auth/billing export holds hashed OAuth codes
# and refresh tokens: it exists precisely because those were never allowed
# into the append DB behind the public SQL console, and committing them to
# a public repo would undo that in one keystroke.
backups/
